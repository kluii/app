# Klui configuration. Every name here is a contract (docs/deployment.md §3).
# Copy to .env and edit; never commit .env.

# ── Required ────────────────────────────────────────────────────────────────
# The public origin. Absolute URLs (links, Open Graph, OIDC) are built from it.
KLUI_PUBLIC_URL=http://localhost:8080

# Postgres. The compose stack creates this database and keeps it in klui_pgdata.
POSTGRES_PASSWORD=change-me-before-you-expose-this

# ── Secrets ─────────────────────────────────────────────────────────────────
# Generated on first boot into KLUI_SECRETS_DIR when unset in development.
# In production they are required: a regenerated session secret signs everyone out.
# KLUI_SESSION_SECRET=<openssl rand -base64 32>
# KLUI_TOKEN_PEPPER=<openssl rand -hex 32>
# KLUI_ENCRYPTION_KEY=<openssl rand -base64 32>

# ── Runtime ─────────────────────────────────────────────────────────────────
KLUI_ENV=production
KLUI_PORT=8080
KLUI_SECRETS_DIR=/data/secrets
# Number of reverse proxies in front of the app; 1 for Caddy or Traefik on the same host.
KLUI_TRUSTED_PROXY_HOPS=0
KLUI_REGISTRATION_OPEN=true
KLUI_TOTP_POLICY=available
KLUI_LOG_LEVEL=info
KLUI_RETENTION_EVENTS_DAYS=365

# ── Optional integrations (unset means off, never a silent no-op) ───────────
# KLUI_SMTP_HOST=smtp.example.com
# KLUI_SMTP_PORT=587
# KLUI_SMTP_USER=
# KLUI_SMTP_PASS=
# KLUI_SMTP_FROM=boards@example.com
# KLUI_ANALYTICS_URL=
# KLUI_METRICS_ENABLED=false
# KLUI_METRICS_TOKEN=
# KLUI_CAPTCHA_ENABLED=false
# KLUI_CAPTCHA_URL=
# KLUI_DIGEST_LLM_URL=
# KLUI_DIGEST_LLM_KEY=
# KLUI_OPENAPI=false
# KLUI_DEMO_RESET=false

# ── OIDC providers (all flags default off) ──────────────────────────────────
# KLUI_OIDC_DISCORD_CLIENT_ID=
# KLUI_OIDC_DISCORD_CLIENT_SECRET=
# KLUI_OIDC_GITHUB_CLIENT_ID=
# KLUI_OIDC_GITHUB_CLIENT_SECRET=
