{
  "semi": true,
  "singleQuote": true,
  "trailingComma": "all",
  "printWidth": 100,
  "arrowParens": "always",
  "overrides": [
    {
      "files": ["*.css"],
      "options": { "singleQuote": false }
    },
    {
      "files": ["*.json", "*.jsonc"],
      "options": { "printWidth": 120 }
    }
  ]
}
